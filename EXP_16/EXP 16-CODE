#include <reg51.h>
#include <stdio.h>

// Serial Interrupt Service Routine
void serial_ISR(void) interrupt 4
{
    char ch;

    if (RI)
    {
        RI = 0;
        ch = SBUF;

        printf("\n>>> INTERRUPT RECEIVED: ");
        printf("%c\n", ch);
    }
}

// Delay Function
void delay(void)
{
    unsigned int i;

    for (i = 0; i < 50000; i++);
}

// Main Function
void main(void)
{
    SCON = 0x50;
    TMOD = 0x20;
    TH1 = 0xFD;
    TR1 = 1;

    IE = 0x90;
    TI = 1;

    while (1)
    {
        printf("Hello World\n");
        delay();
    }
}
